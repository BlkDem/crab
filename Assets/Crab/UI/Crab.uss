/* "Краб против ада": dark glassy panels with orange-gold accents (the concept sheet), green for
   the Spark's matter. Sizes are CSS pixels (constant physical size at 96 dpi). */
:root {
    --panel: rgba(8, 10, 14, 0.72);
    --edge: rgba(255, 170, 70, 0.35);
    --text: #f3ece0;
    --muted: rgba(240, 225, 205, 0.6);
    --orange: #ff8a2a;
    --gold: #ffc65a;
    --green: #7dffb2;
    --red: #ff4a3a;
    -unity-font-definition: url("Fonts/Nunito-SemiBold.ttf");
    color: var(--text);
    font-size: 15px;
}
.title-font { -unity-font-definition: url("Fonts/RussoOne-Regular.ttf"); }
.bold { -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf"); }
.unity-label { padding: 0; margin: 0; }
.unity-button { background-color: rgba(0, 0, 0, 0); border-width: 0; margin: 0; padding: 0; min-height: 0; color: var(--text); }
.unity-button:hover, .unity-button:active { background-color: rgba(0, 0, 0, 0); }

.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* health and matter (top left) */
.status { position: absolute; left: 22px; top: 20px; }
.hp-row { flex-direction: row; align-items: center; }
.hp-icon { width: 22px; height: 22px; margin-right: 8px; }
.hp-bar { width: 260px; height: 16px; border-radius: 8px; background-color: rgba(0, 0, 0, 0.55); border-width: 1px; border-color: var(--edge); overflow: hidden; }
.hp-fill { height: 100%; border-radius: 8px; background-color: var(--orange); }
.hp-text { margin-left: 10px; font-size: 13px; color: var(--muted); }
.matter-row { flex-direction: row; margin-top: 10px; }
.matter { flex-direction: row; align-items: center; margin-right: 14px; padding: 4px 10px 4px 6px; border-radius: 12px; background-color: var(--panel); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.matter .dot { width: 12px; height: 12px; border-radius: 6px; margin-right: 6px; }
.matter Label { font-size: 14px; -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf"); }
.matter .name { font-size: 11px; color: var(--muted); margin-left: 5px; -unity-font-definition: url("Fonts/Nunito-SemiBold.ttf"); }

/* objective (top right) */
.objective { position: absolute; right: 22px; top: 20px; max-width: 380px; padding: 10px 16px; border-radius: 10px; background-color: var(--panel); border-left-width: 3px; border-color: var(--orange);
    transition-property: opacity; transition-duration: 0.4s; }
.objective .head { font-size: 11px; color: var(--orange); -unity-font-definition: url("Fonts/RussoOne-Regular.ttf"); letter-spacing: 1px; }
.objective .text { font-size: 15px; white-space: normal; margin-top: 3px; }

/* weapon (bottom right) */
.weapon { position: absolute; right: 22px; bottom: 22px; align-items: flex-end; }
.weapon .name { font-size: 22px; -unity-font-definition: url("Fonts/RussoOne-Regular.ttf"); color: var(--gold); }
.weapon .count { font-size: 14px; color: var(--muted); margin-top: 2px; }
.slots { flex-direction: row; margin-top: 8px; }
.slot { width: 34px; height: 34px; margin-left: 5px; border-radius: 6px; background-color: var(--panel); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); align-items: center; justify-content: center; }
.slot Label { font-size: 12px; color: var(--muted); }
.slot.on { border-color: var(--gold); background-color: rgba(255, 170, 70, 0.18); }
.slot.on Label { color: var(--text); }

/* thoughts, hints, prompt */
.thought { position: absolute; left: 0; right: 0; bottom: 120px; flex-direction: row; justify-content: center; opacity: 0; transition-property: opacity; transition-duration: 0.6s; }
.thought.show { opacity: 1; }
.thought Label { max-width: 760px; padding: 10px 22px; border-radius: 14px; background-color: rgba(10, 8, 6, 0.6); font-size: 20px; color: #fff3dd; -unity-font-style: italic; white-space: normal; -unity-text-align: middle-center;
    border-width: 1px; border-color: rgba(255, 210, 120, 0.3); }
.hint { position: absolute; left: 0; right: 0; bottom: 74px; flex-direction: row; justify-content: center; opacity: 0; transition-property: opacity; transition-duration: 0.4s; }
.hint.show { opacity: 1; }
.hint Label { padding: 6px 14px; border-radius: 10px; background-color: var(--panel); font-size: 14px; color: var(--muted); white-space: normal; max-width: 820px; -unity-text-align: middle-center; }
.prompt { position: absolute; left: 0; right: 0; top: 56%; flex-direction: row; justify-content: center; }
.prompt Label { padding: 6px 14px; border-radius: 8px; background-color: rgba(0, 0, 0, 0.55); font-size: 15px; -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf"); color: var(--green); }
.crosshair { position: absolute; left: 50%; top: 50%; width: 22px; height: 22px; translate: -50% -50%; }

/* boss bar */
.boss { position: absolute; left: 0; right: 0; top: 18px; align-items: center; display: none; }
.boss .name { font-size: 20px; -unity-font-definition: url("Fonts/RussoOne-Regular.ttf"); color: #c8ffe0; letter-spacing: 2px; }
.boss .bar { width: 560px; height: 14px; margin-top: 6px; border-radius: 7px; background-color: rgba(0, 0, 0, 0.6); border-width: 1px; border-color: rgba(125, 255, 178, 0.4); overflow: hidden; }
.boss .fill { height: 100%; background-color: var(--green); }

/* title cards */
.titlecard { position: absolute; left: 0; right: 0; top: 30%; align-items: center; opacity: 0; transition-property: opacity, scale; transition-duration: 1.2s; scale: 0.96 0.96; }
.titlecard.show { opacity: 1; scale: 1 1; }
.titlecard .main { font-size: 64px; -unity-font-definition: url("Fonts/RussoOne-Regular.ttf"); color: var(--orange); -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(60, 10, 0, 0.8); }
.titlecard .sub { font-size: 22px; margin-top: 6px; color: var(--gold); -unity-font-style: italic; }

/* overlays */
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.vignette { border-width: 60px; border-color: rgba(255, 30, 10, 0.5); opacity: 0; }

/* create (matter into things) */
.create { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(4, 10, 8, 0.45); display: none; }
.create .ring { width: 560px; height: 560px; }
.create .center { position: absolute; left: 50%; top: 50%; width: 220px; translate: -50% -50%; align-items: center; }
.create .center .head { font-size: 20px; -unity-font-definition: url("Fonts/RussoOne-Regular.ttf"); color: var(--green); }
.create .center .sub { font-size: 12px; color: var(--muted); margin-top: 4px; -unity-text-align: middle-center; white-space: normal; }
.bp { position: absolute; width: 170px; padding: 10px 12px; border-radius: 12px; background-color: rgba(10, 16, 14, 0.88); border-width: 1px; border-color: rgba(125, 255, 178, 0.25); translate: -50% -50%; }
.bp:hover { border-color: var(--green); background-color: rgba(30, 60, 45, 0.92); }
.bp .name { font-size: 16px; -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf"); white-space: normal; }
.bp .cost { font-size: 12px; color: var(--muted); margin-top: 3px; white-space: normal; }
.bp .have { font-size: 11px; color: var(--gold); margin-top: 2px; }
.bp.cannot { opacity: 0.45; }
.bp.locked { opacity: 0.25; }

/* menus */
.menu { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 4, 6, 0.6); align-items: center; justify-content: center; display: none; }
.menu-box { width: 420px; padding: 28px 30px; border-radius: 16px; background-color: rgba(12, 12, 16, 0.92); border-width: 1px; border-color: var(--edge); align-items: stretch; }
.menu-title { font-size: 34px; -unity-font-definition: url("Fonts/RussoOne-Regular.ttf"); color: var(--orange); -unity-text-align: middle-center; margin-bottom: 18px; }
.menu-btn { margin-top: 8px; padding: 11px; border-radius: 10px; background-color: rgba(255, 140, 40, 0.12); border-width: 1px; border-color: rgba(255, 170, 70, 0.3); font-size: 17px; -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf"); }
.menu-btn:hover { background-color: rgba(255, 140, 40, 0.3); border-color: var(--orange); }
.menu-row { margin-top: 12px; }
.menu-row Label { font-size: 13px; color: var(--muted); }
.menu-row Slider { margin: 4px 0 0 0; }
.menu-row .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.15); border-width: 0; }
.menu-row .unity-base-slider__dragger { background-color: var(--orange); border-width: 0; border-radius: 7px; width: 14px; height: 14px; margin-top: -6px; }
.menu-note { margin-top: 14px; font-size: 12px; color: var(--muted); white-space: normal; -unity-text-align: middle-center; }

/* main menu */
.main-title { font-size: 92px; -unity-font-definition: url("Fonts/RussoOne-Regular.ttf"); color: var(--orange); -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(60, 10, 0, 0.9); }
.main-sub { font-size: 36px; -unity-font-definition: url("Fonts/RussoOne-Regular.ttf"); color: var(--gold); margin-top: -10px; }
.main-col { position: absolute; left: 80px; top: 18%; }
.main-btns { margin-top: 40px; width: 320px; }
.main-foot { position: absolute; left: 80px; bottom: 30px; font-size: 12px; color: var(--muted); }
.level { margin-top: 8px; font-size: 12px; color: var(--gold); -unity-font-definition: url("Fonts/RussoOne-Regular.ttf"); letter-spacing: 1px; }

/* the circle of Despondency: will, whispers from the dark, the AI */
.will-row { flex-direction: row; align-items: center; margin-top: 4px; }
.will-name { font-size: 12px; color: #9ab8ff; width: 38px; }
.will-bar { width: 160px; height: 8px; border-radius: 4px; background-color: rgba(0, 0, 0, 0.55); overflow: hidden; border-width: 1px; border-color: rgba(140, 170, 255, 0.4); }
.will-fill { height: 100%; background-color: #8aa8ff; }
.whisper { position: absolute; opacity: 0; transition-property: opacity; transition-duration: 1.2s; }
.whisper.show { opacity: 0.85; }
.whisper Label { font-size: 22px; color: #b8c0d8; -unity-font-style: italic; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.8); letter-spacing: 1px; }
.ai { position: absolute; left: 24px; bottom: 170px; max-width: 460px; padding: 8px 14px; border-radius: 10px; background-color: rgba(4, 20, 30, 0.75); border-width: 1px; border-color: rgba(90, 220, 255, 0.5); opacity: 0; transition-property: opacity; transition-duration: 0.4s; }
.ai.show { opacity: 1; }
.ai-head { font-size: 12px; color: #5adcff; -unity-font-definition: url("Fonts/RussoOne-Regular.ttf"); letter-spacing: 2px; }
.ai-text { font-size: 16px; color: #d8f6ff; white-space: normal; }

/* settings (title screen and pause) */
.settings-box { width: 460px; max-height: 88%; }
.settings-scroll { flex-shrink: 1; }
.settings-head { margin-top: 16px; font-size: 13px; color: var(--orange); -unity-font-definition: url("Fonts/Nunito-ExtraBold.ttf"); letter-spacing: 1px; }
.settings-top { flex-direction: row; justify-content: space-between; }
.settings-value { color: var(--gold); }
.settings-switch { padding: 6px 10px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.05); }
.settings-switch:hover { background-color: rgba(255, 140, 40, 0.15); }
.settings-switch.on .settings-value { color: var(--orange); }
.settings-choice { flex-direction: row; margin-top: 6px; }
.settings-choice Button { flex-grow: 1; margin: 0 3px; padding: 7px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.06); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); color: var(--muted); font-size: 14px; }
.settings-choice Button.on { background-color: rgba(255, 140, 40, 0.3); border-color: var(--orange); color: white; }
.main-settings { position: absolute; left: 80px; top: 8%; }
.menu-btn-two { flex-direction: column; align-items: center; padding: 7px; }
.menu-btn-sub { font-size: 12px; color: var(--muted); -unity-font-definition: url("Fonts/Nunito-Regular.ttf"); margin-top: 2px; }
.menu-btn.confirm { border-color: #ff5a3c; color: #ffb4a0; }
.fps { position: absolute; left: 16px; bottom: 10px; font-size: 12px; color: rgba(255, 255, 255, 0.7); }

/* the end: only the words */
.cinema .status, .cinema .objective, .cinema .weapon, .cinema .crosshair, .cinema .prompt, .cinema .hint { opacity: 0; transition-duration: 1s; }
.menu-btn:focus { border-color: var(--orange); background-color: rgba(255, 140, 40, 0.3); }
.settings-switch:focus { background-color: rgba(255, 140, 40, 0.2); }
.menu-row Slider:focus .unity-base-slider__dragger { background-color: var(--gold); width: 18px; height: 18px; margin-top: -8px; }
