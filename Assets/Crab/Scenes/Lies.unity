  m_Name: 
  m_EditorClassIdentifier: Crab.Game::Crab.Game.MemoryShard
  reach: 3
  id: archive
  fresco: {fileID: 1047712794}
  lines:
  - "\u0410\u0440\u0445\u0438\u0432. \u0417\u0430\u043F\u0438\u0441\u0438 \u043E \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044F\u0445 \u0418\u0441\u043A\u0440\u044B: \u0440\u044B\u0446\u0430\u0440\u044C, \u043F\u0442\u0438\u0446\u0430, \u043C\u0430\u0448\u0438\u043D\u0430\u2026 \u043A\u0440\u0430\u0431."
  - "\xAB\u041C\u0438\u0441\u0441\u0438\u044F: \u0434\u043E\u0439\u0442\u0438 \u0434\u043E \u0442\u0440\u043E\u043D\u0430 \u0410\u0434\u0430\xBB. \u041F\u043E\u0434\u043F\u0438\u0441\u044C\u2026 \u0441\u0442\u0451\u0440\u0442\u0430. \u042D\u0442\u043E \u043F\u0438\u0441\u0430\u043B \u043D\u0435 \u0411\u043E\u0433."
  - "\xAB\u041D\u043E\u0441\u0438\u0442\u0435\u043B\u0438 \u2014 \u0440\u0430\u0441\u0445\u043E\u0434\u043D\u044B\u0439 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B. \u0426\u0435\u043B\u044C \u2014 \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0442\u0440\u043E\u043D\xBB. \u041E\u0442\u043A\u0440\u044B\u0442\u044C \u2014 \u0434\u043B\u044F \u043A\u043E\u0433\u043E?"
  seen: 0
  frescoLight: {fileID: 830279317}
