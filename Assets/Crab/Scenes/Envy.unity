  lines:
  - "\u041C\u044B \u0436\u0434\u0430\u043B\u0438 \u0442\u0435\u0431\u044F, \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C. \u041E\u0447\u0435\u043D\u044C \u0434\u043E\u043B\u0433\u043E \u0436\u0434\u0430\u043B\u0438."
  - "\u0418\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u043D\u0430 \u0445\u043E\u043B\u043C\u0435 \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0442\u0435\u0431\u0435, \u043A\u0442\u043E \u0442\u044B."
  - "\u0418\u0434\u0438. \u041C\u044B \u0431\u0443\u0434\u0435\u043C \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430 \u0442\u0435\u0431\u044F. \u0412\u0441\u0435."
