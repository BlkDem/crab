  m_Script: {fileID: 11500000, guid: d5e20477f04c97f42a2a9cb473e5305e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Crab.Game::Crab.Game.Dweller
  reach: 3
  title: "\u041F\u0435\u0432\u0443\u043D\u044C\u044F"
  lines:
  - "\u041B\u044F-\u043B\u044F! \u0422\u044B \u043F\u0440\u0438\u0448\u0451\u043B \u043F\u0435\u0442\u044C \u0441 \u043D\u0430\u043C\u0438?"
  - "\u041D\u0430\u0432\u0435\u0440\u0445\u0443, \u043D\u0430 \u0445\u043E\u043B\u043C\u0435, \u0418\u0441\u0442\u043E\u0447\u043D\u0438\u043A. \u041E\u043D \u0434\u0430\u0451\u0442 \u0432\u0441\u0451, \u0447\u0435\u0433\u043E \u043F\u043E\u0436\u0435\u043B\u0430\u0435\u0448\u044C!"
  - "\u041F\u043E\u0447\u0435\u043C\u0443 \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u0442\u043E, \u0447\u0435\u0433\u043E \u043D\u0435\u0442 \u0443 \u043C\u0435\u043D\u044F?"
  model: {fileID: 1864189952}
  talked: 0
