  - "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C, \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439! \u0417\u0434\u0435\u0441\u044C \u0443 \u0432\u0441\u0435\u0445 \u0432\u0441\u0451 \u0435\u0441\u0442\u044C."
  - "\u041E\u0441\u0442\u0430\u043D\u044C\u0441\u044F. \u0422\u0443\u0442 \u043D\u0438\u043A\u0442\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u043B\u0430\u0447\u0435\u0442."
  - "\u0410 \u0447\u0442\u043E \u044D\u0442\u043E \u0441\u0432\u0435\u0442\u0438\u0442\u0441\u044F \u0443 \u0442\u0435\u0431\u044F \u0432\u043D\u0443\u0442\u0440\u0438?.."
