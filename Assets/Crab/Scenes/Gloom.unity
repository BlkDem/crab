  m_Script: {fileID: 11500000, guid: 5682e615ebd55aa438374fd8504e2b45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Crab.Game::Crab.Game.MemoryShard
  reach: 2.6
  id: bird
  fresco: {fileID: 565078206}
  lines:
  - "\u041F\u0442\u0438\u0446\u0430. \u041E\u0433\u0440\u043E\u043C\u043D\u0430\u044F, \u043E\u0433\u043D\u0435\u043D\u043D\u0430\u044F. \u0418\u0441\u043A\u0440\u0430 \u0433\u043E\u0440\u0435\u043B\u0430 \u0443 \u043D\u0435\u0451 \u043F\u043E\u0434 \u043A\u0440\u044B\u043B\u043E\u043C."
  - "\u041E\u043D\u0430 \u043B\u0435\u0442\u0435\u043B\u0430 \u043D\u0430\u0434 \u043A\u0440\u0443\u0433\u0430\u043C\u0438 \u0430\u0434\u0430, \u0438 \u0434\u0435\u043C\u043E\u043D\u044B \u043F\u0440\u044F\u0442\u0430\u043B\u0438\u0441\u044C \u043E\u0442 \u0435\u0451 \u0441\u0432\u0435\u0442\u0430."
  - "\u041E\u043D\u0430 \u0434\u043E\u0448\u043B\u0430 \u0434\u043E \u0448\u0435\u0441\u0442\u043E\u0433\u043E \u043A\u0440\u0443\u0433\u0430\u2026 \u0438 \u0443\u043F\u0430\u043B\u0430. \u0418\u0441\u043A\u0440\u0430 \u0441\u043D\u043E\u0432\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043E\u0434\u043D\u0430."
  seen: 0
  frescoLight: {fileID: 477665308}
