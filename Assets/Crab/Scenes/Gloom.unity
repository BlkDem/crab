  m_Script: {fileID: 11500000, guid: 5682e615ebd55aa438374fd8504e2b45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Crab.Game::Crab.Game.MemoryShard
  reach: 2.6
  id: machine
  fresco: {fileID: 922611866}
  lines:
  - "\u041C\u0430\u0448\u0438\u043D\u0430. \u0413\u0438\u0433\u0430\u043D\u0442 \u0438\u0437 \u043C\u0435\u0442\u0430\u043B\u043B\u0430, \u0430 \u0432 \u043D\u0451\u043C \u2014 \u0418\u0441\u043A\u0440\u0430 \u0438 \u0447\u0435\u0439-\u0442\u043E \u0433\u043E\u043B\u043E\u0441."
  - "\u041E\u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u0430 \u0434\u0430\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0445. \u0412\u043E\u0441\u044C\u043C\u043E\u0439 \u043A\u0440\u0443\u0433. \u0414\u0435\u0432\u044F\u0442\u044B\u0439\u2026"
  - "\u2026\u0438 \u0437\u0430\u043C\u0435\u0440\u043B\u0430. \u0417\u0434\u0435\u0441\u044C, \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435. \u0418\u0441\u043A\u0440\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0430\u0441\u044C \u043D\u0430\u0432\u0435\u0440\u0445 \u2014 \u0438 \u0443\u043F\u0430\u043B\u0430 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433. \u041A\u043E \u043C\u043D\u0435."
  seen: 0
  frescoLight: {fileID: 85507451}
