  m_Script: {fileID: 11500000, guid: 5682e615ebd55aa438374fd8504e2b45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Crab.Game::Crab.Game.MemoryShard
  reach: 2.6
  id: knight
  fresco: {fileID: 2122707169}
  lines:
  - "\u0412\u0438\u0434\u0435\u043D\u0438\u0435\u2026 \u0420\u044B\u0446\u0430\u0440\u044C \u0432 \u0441\u0438\u044F\u044E\u0449\u0438\u0445 \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445. \u0412 \u0435\u0433\u043E \u0433\u0440\u0443\u0434\u0438 \u2014 \u0418\u0441\u043A\u0440\u0430. \u041C\u043E\u044F \u0418\u0441\u043A\u0440\u0430."
  - "\u041E\u043D \u0448\u0451\u043B \u0447\u0435\u0440\u0435\u0437 \u0430\u0434 \u0441 \u043C\u0435\u0447\u043E\u043C. \u041E\u043D \u0434\u043E\u0448\u0451\u043B \u0434\u043E \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u043A\u0440\u0443\u0433\u0430\u2026"
  - "\u2026\u0438 \u043F\u043E\u0433\u0430\u0441. \u0418\u0441\u043A\u0440\u0430 \u0432\u044B\u043F\u0430\u043B\u0430 \u0438\u0437 \u043D\u0435\u0433\u043E, \u043A\u0430\u043A \u0443\u0433\u043E\u043B\u0451\u043A, \u0438 \u043F\u043E\u043A\u0430\u0442\u0438\u043B\u0430\u0441\u044C \u0434\u0430\u043B\u044C\u0448\u0435."
  seen: 0
  frescoLight: {fileID: 384538677}
